{
  "version": 1,
  "data_dir": ".nous",
  "workspace": ".",
  "skills_dir": "skills",
  "memory": {
    "backend": "sqlite",
    "api_key_env": "MEM0_API_KEY",
    "namespace": "nous-workstation"
  },
  "orchestration": {
    "graph": "router -> creative|implement|review|action|cloud_gpu",
    "default_route": "cloud-api",
    "memory_backend": "sqlite-vec",
    "fallback_memory_backend": "sqlite-text",
    "cloud_gpu_auto_shutdown_minutes": 10
  },
  "accounts": {
    "openai_codex": {
      "provider": "openai",
      "roles": ["review"],
      "api_key_env": "OPENAI_CODEX_API_KEY"
    },
    "openai_gpt": {
      "provider": "openai",
      "roles": ["router"],
      "api_key_env": "OPENAI_GPT_API_KEY"
    },
    "anthropic_claude": {
      "provider": "anthropic",
      "roles": ["implement"],
      "api_key_env": "ANTHROPIC_API_KEY"
    },
    "xai_grok": {
      "provider": "xai",
      "roles": ["creative"],
      "api_key_env": "XAI_API_KEY"
    },
    "manus": {
      "provider": "manus",
      "roles": ["action"],
      "api_key_env": "MANUS_API_KEY"
    },
    "cloud_llama": {
      "provider": "llama",
      "roles": ["cloud_gpu"],
      "endpoint_env": "NOUS_CLOUD_LLAMA_URL",
      "token_env": "NOUS_CLOUD_LLAMA_TOKEN"
    }
  },
  "providers": {
    "demo": {
      "kind": "demo"
    },
    "bridge-example": {
      "kind": "command",
      "enabled": true,
      "argv": [
        "{python}",
        "examples/bridge.py"
      ],
      "timeout_seconds": 30
    },
    "llama-local": {
      "kind": "command",
      "enabled": false,
      "argv": [],
      "note": "Ative somente após configurar um adaptador HTTP para o llama.cpp em 127.0.0.1:8081."
    },
    "llama-cloud": {
      "kind": "command",
      "enabled": false,
      "argv": [],
      "note": "GPU privada em nuvem. Requer adaptador HTTPS autenticado; nunca exponha a porta do llama.cpp."
    },
    "manus": {
      "kind": "manus",
      "enabled": true,
      "api_key_env": "MANUS_API_KEY",
      "endpoint": "https://api.manus.ai/v2/task.create",
      "locale": "pt-BR",
      "agent_profile": "standard",
      "timeout_seconds": 120
    },
    "openai": {
      "kind": "command",
      "enabled": false,
      "argv": [],
      "note": "Adaptador nativo pendente"
    },
    "codex": {
      "kind": "command",
      "enabled": false,
      "argv": [],
      "note": "Adaptador nativo pendente"
    },
    "claude-code": {
      "kind": "command",
      "enabled": false,
      "argv": [],
      "note": "Adaptador de agente local pendente; nao confundir com a API de mensagens."
    },
    "claude-api": {
      "kind": "anthropic",
      "enabled": true,
      "api_key_env": "ANTHROPIC_API_KEY",
      "endpoint": "https://api.anthropic.com/v1/messages",
      "model": "claude-sonnet-4-5-20250929",
      "max_tokens": 2048,
      "timeout_seconds": 120,
      "note": "No de texto da Anthropic; nao executa ferramentas locais automaticamente."
    },
    "gemini": {
      "kind": "gemini",
      "enabled": true,
      "api_key_env": "GEMINI_API_KEY",
      "base_url": "https://generativelanguage.googleapis.com/v1beta/models",
      "model": "gemini-3.8-flash",
      "max_output_tokens": 2048,
      "timeout_seconds": 120
    },
    "grok": {
      "kind": "grok",
      "enabled": true,
      "api_key_env": "XAI_API_KEY",
      "base_url": "https://api.x.ai/v1",
      "model": "grok-4.7",
      "timeout_seconds": 120
    }
  }
}
